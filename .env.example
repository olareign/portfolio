# Free tier — get a key at https://aistudio.google.com/apikey (no card required).
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset. Google changes free-tier quotas
# and model lineup often without a changelog entry; check your live limits at
# aistudio.google.com before relying on a specific model, and swap this if needed.
GEMINI_MODEL=

# Real production domain, used for metadataBase, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=
